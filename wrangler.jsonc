{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default top-level target is STAGING so accidental `npx wrangler deploy` never overwrites production.
  "name": "pacificregionalsoccer-staging",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "r2_buckets": [
    {
      "binding": "QUOTE_UPLOADS_BUCKET",
      "bucket_name": "prsl-quote-uploads-staging"
    }
  ],
  "triggers": {
    // Runs daily at 09:00 UTC to automatically delete any R2 quote uploads older than 14 days
    "crons": ["0 9 * * *"]
  },
  "env": {
    "staging": {
      "name": "pacificregionalsoccer-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "r2_buckets": [
        {
          "binding": "QUOTE_UPLOADS_BUCKET",
          "bucket_name": "prsl-quote-uploads-staging"
        }
      ]
    },
    "production": {
      "name": "pacificregionalsoccer",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://pacificregionalsoccer.com"
      },
      "r2_buckets": [
        {
          "binding": "QUOTE_UPLOADS_BUCKET",
          "bucket_name": "prsl-quote-uploads"
        }
      ]
    }
  }
}
